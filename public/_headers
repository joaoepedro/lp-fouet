# Cabeçalhos da Cloudflare Pages (este arquivo não vira página)

# Imagens e fontes: cache longo. Ao trocar um arquivo, troque também o nome.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# CSS e JS: cache curto, para as alterações aparecerem logo
/css/*
  Cache-Control: public, max-age=3600, must-revalidate
/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Todas as páginas. Cada caminho só pode aparecer uma vez: com dois blocos /*
# a Cloudflare aplica só o último.
# DEMONSTRAÇÃO: apagar a linha X-Robots-Tag quando o cliente aprovar.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Robots-Tag: noindex
